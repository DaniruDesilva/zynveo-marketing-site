# Analytics Tracking & Verification Keys
# Replace these with your actual IDs from Google and Microsoft

# 1. Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Get from: https://analytics.google.com -> Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 2. Google Search Console Site Verification Tag (HTML Tag Content string)
# Get from: https://search.google.com/search-console -> Settings -> Ownership Verification -> HTML Tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 3. Microsoft Clarity Project ID (Format: 10 character code e.g. abc123xyz0)
# Get from: https://clarity.microsoft.com -> Settings -> Overview -> Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
