# ═══════════════════════════════════════════════════════════════════════════
# Zynveo Cloud OS (Enterprise ERP) — Environment Configuration Template
# Copy this file to .env and fill in the required values.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# 1. PostgreSQL Database
# Local Dev Docker Postgres (default during development):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zynveo_erp"
# Supabase Pooler (production / staging):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# 2. Redis (NestJS Microservices RPC Transport & BullMQ Durable Queues)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# 3. API Gateway & Service Health Ports
API_GATEWAY_PORT=4000
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:4000"
SVC_IAM_HEALTH_PORT=4001
SVC_FINANCE_HEALTH_PORT=4002
SVC_HR_HEALTH_PORT=4003
SVC_PROCUREMENT_HEALTH_PORT=4004
SVC_INVENTORY_HEALTH_PORT=4005
SVC_MANUFACTURING_HEALTH_PORT=4006
SVC_SALES_CRM_HEALTH_PORT=4007
SVC_BI_HEALTH_PORT=4008

# 4. Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
SUPABASE_JWKS_URI="https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_SECRET="<your-supabase-jwt-secret>"

# 5. PowerSync Offline Engine
NEXT_PUBLIC_POWERSYNC_URL="https://<your-instance-id>.powersync.journeyapps.com"
NEXT_PUBLIC_DEMO_MODE="false"

# 6. AWS S3 / LocalStack (Payslip PDFs & ERP Document Storage)
AWS_REGION="ap-south-1"
AWS_S3_ENDPOINT="http://localhost:4566"
AWS_S3_FORCE_PATH_STYLE="true"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_S3_BUCKET_DOCUMENTS="zynveo-erp-documents"

